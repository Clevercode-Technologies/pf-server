PORT=4000
FRONTEND_ORIGINS=http://localhost:3000,https://www.patientsflow.co.uk

# error | warn | info | debug. Use "debug" for full mail request/response detail.
LOG_LEVEL=info

# Configure these values in .env. Keep the API key private.
# Paste the key exactly as shown in the ZeptoMail dashboard. It may be given
# with or without the leading "Zoho-enczapikey " prefix; the server strips a
# stray prefix and adds it exactly once. A doubled prefix makes Zoho answer
# with an opaque HTTP 500 and an empty response body.
ZEPTOMAIL_HOST=https://cpaas.zoho.com
ZEPTOMAIL_API_KEY=
MAIL_FROM_ADDRESS=contact@app.patientsflow.co.uk
MAIL_FROM_NAME=Patients Flow
CONTACT_INBOX=contact@app.patientsflow.co.uk
